// updated from version 2.0:
// [1]: Just update the genome length from 1e8 -> 5e8
// [2]: Drop back down to 25K individuals 
// [3]: Move up to 375K ticks so hoping most of the trees 
//        will coalesce
initialize() {
    defineConstant("start_time", clock());
    initializeTreeSeq();
    initializeMutationRate(MU * PI_TARGET);
    initializeRecombinationRate(1e-8);
    initializeMutationType("m2", 0.5, "n", 0.0, 0.1);  // effect sizes ~ N(0, 0.1)
    m2.convertToSubstitution = F;
    initializeGenomicElementType("g2", m2, 1);
    initializeGenomicElement(g2, 0, L-1);
}

mutationEffect(m2) { return 1.0; }   // neutral at the locus level

fitnessEffect() {
    phenotype = individual.sumOfMutationsOfType(m2);
    return exp(-(phenotype^2) / (2 * V_S));
}

1 early() { sim.addSubpop("p1", NE); }

1: late() {
    if (community.tick % 1000 == 0) {
        elapsed = clock() - start_time;
        gen_per_sec = community.tick / elapsed;
        remaining_gens = END_TICK - community.tick;
        remaining_secs = remaining_gens / gen_per_sec;

        inds = sim.subpopulations.individuals;
        phenotypes = inds.sumOfMutationsOfType(m2);

        cat("Tick " + community.tick + " / " + END_TICK
            + "  V_P: " + format("%.4f", var(phenotypes))
            + "  (" + format("%.0f", elapsed) + "s elapsed, "
            + format("%.0f", remaining_secs) + "s remaining)\n");
    }
}

50000:375000 late() {
    if (community.tick % 50000 == 0) {
        sim.treeSeqOutput(outfile + ".tick" + community.tick);
        catn("Checkpoint at tick " + community.tick);
    }
}

END_TICK late() {
    sim.treeSeqOutput(outfile + ".trees");
    sim.simulationFinished();
}