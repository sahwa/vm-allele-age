// v5.0 — Gaussian stabilising selection on an additive trait.
//
// Changes from v2.1:
//   [A] NEUTRAL flag          -> the lambda = 0 null run (the single most
//                                valuable control: the pipeline must report
//                                zero ascertainment bias here).
//   [B] MEAN_EFFECT parameter -> a skewed DFE, so E[beta] != 0 can be tested.
//                                With a symmetric DFE that assumption is true
//                                by construction and is never tested.
//   [C] Derived diagnostics   -> every run reports V_G, V_M, V_M/V_P, V_S/V_P
//                                and the predicted lambda, so each rung of the
//                                ladder is interpretable as a TRAIT rather
//                                than as a parameter setting.
//   [D] Optional growth phase -> off by default. Demography drives the
//                                singleton age distribution, which drives the
//                                ascertainment bias.
//   [E] Summary file written at the end for the sweep table.
//
// Required -d constants:  MU, PI_TARGET, L, NE, V_S, END_TICK, outfile
// Optional -d constants:  NEUTRAL, MEAN_EFFECT, SD_EFFECT, GROWTH_RATE,
//                         GROWTH_TICKS, CKPT_EVERY, RESUME, LOG_EVERY
//
// NOTE ON lambda: the predicted value below is sigma2_m / V_S, which pairs
// with the age-only decay written as 1/(1 + lambda*t/2). If you fit your decay
// curve as 1/(1 + lambda*t) you will measure HALF this. Do not rely on either
// convention -- measure lambda from the fitted decay of E[beta^2] on true age
// and treat the predicted value purely as a check on the derivation.
//
// NOTE ON PHENOTYPES: there is no environmental variance here, so selection
// acts on the genetic value directly and V_P = V_G. Add sigma2_e in
// post-processing (y_i = z_i/sqrt(V_P) + e_i); that way one run serves every
// target h2.

initialize() {
    if (!exists("RESUME"))       defineConstant("RESUME", "");
    if (!exists("CKPT_EVERY"))   defineConstant("CKPT_EVERY", 10000);
    if (!exists("LOG_EVERY"))    defineConstant("LOG_EVERY", 1000);
    if (!exists("NEUTRAL"))      defineConstant("NEUTRAL", F);
    if (!exists("MEAN_EFFECT"))  defineConstant("MEAN_EFFECT", 0.0);
    if (!exists("SD_EFFECT"))    defineConstant("SD_EFFECT", 0.1);
    if (!exists("GROWTH_RATE"))  defineConstant("GROWTH_RATE", 0.0);
    if (!exists("GROWTH_TICKS")) defineConstant("GROWTH_TICKS", 0);
    defineConstant("start_time", clock());

    // sigma2_m = E[beta^2] = mean^2 + sd^2.  Shifting the mean changes BOTH
    // the directional component and sigma2_m, so report it explicitly.
    defineConstant("SIGMA2_M", MEAN_EFFECT^2 + SD_EFFECT^2);
    // expected new trait-affecting mutations per diploid per generation
    defineConstant("U_TRAIT", 2 * MU * PI_TARGET * L);
    defineConstant("V_M", U_TRAIT * SIGMA2_M);
    defineConstant("LAMBDA_PRED", NEUTRAL ? 0.0 else SIGMA2_M / V_S);

    initializeTreeSeq();
    initializeMutationRate(MU * PI_TARGET);
    initializeRecombinationRate(1e-8);
    initializeMutationType("m2", 0.5, "n", MEAN_EFFECT, SD_EFFECT);
    m2.convertToSubstitution = T;
    initializeGenomicElementType("g2", m2, 1);
    initializeGenomicElement(g2, 0, L - 1);
}

mutationEffect(m2) { return 1.0; }        // neutral at the locus level

fitnessEffect() {
    if (NEUTRAL) return 1.0;              // [A] the lambda = 0 null
    phenotype = individual.sumOfMutationsOfType(m2) + FIXED_OFFSET;
    return exp(-(phenotype^2) / (2 * V_S));
}

1 early() {
    if (RESUME != "") {
        sim.readFromPopulationFile(RESUME);
        catn("Resumed from " + RESUME + " at tick " + community.tick);
    } else {
        sim.addSubpop("p1", NE);
    }
    defineGlobal("FIXED_OFFSET", 2 * sum(sim.substitutions.selectionCoeff));

    catn("=== configuration ===");
    catn("  NEUTRAL      " + NEUTRAL);
    catn("  V_S          " + V_S);
    catn("  MEAN_EFFECT  " + MEAN_EFFECT + "   SD_EFFECT " + SD_EFFECT);
    catn("  sigma2_m     " + format("%.4e", SIGMA2_M));
    catn("  U_trait      " + format("%.4f", U_TRAIT) + " muts/diploid/gen");
    catn("  V_M          " + format("%.4e", V_M));
    catn("  lambda_pred  " + format("%.4e", LAMBDA_PRED)
         + "   (convention: 1/(1 + lambda*t/2); halve for 1/(1+lambda*t))");
    catn("  growth       rate " + GROWTH_RATE + " over last "
         + GROWTH_TICKS + " ticks");
    catn("=====================");
}

1: late() {
    // must run before fitness recalculation at the end of the tick
    defineGlobal("FIXED_OFFSET", 2 * sum(sim.substitutions.selectionCoeff));

    // [D] optional exponential growth over the final GROWTH_TICKS generations.
    // Kept inline rather than as a scheduled block so there is no rescheduling
    // to get wrong. Replace with a published human model when you need one.
    if (GROWTH_RATE > 0 & GROWTH_TICKS > 0) {
        g0 = END_TICK - GROWTH_TICKS;
        if (community.tick > g0) {
            newN = asInteger(round(NE * exp(GROWTH_RATE * (community.tick - g0))));
            p1.setSubpopulationSize(newN);
        }
    }

    if (community.tick % LOG_EVERY == 0) {
        elapsed = clock() - start_time;
        inds = sim.subpopulations.individuals;
        z  = inds.sumOfMutationsOfType(m2) + FIXED_OFFSET;
        vg = var(z);
        // [C] emergent quantities -- these are what make the run interpretable
        cat("Tick " + community.tick + " / " + END_TICK
            + "  N: " + size(inds)
            + "  mean_z: "  + format("%.3f", mean(z))
            + "  V_G: "     + format("%.4f", vg)
            + "  V_M/V_P: " + format("%.3e", V_M / vg)
            + "  V_S/V_P: " + format("%.2f", NEUTRAL ? 0.0 else V_S / vg)
            + "  n_seg: "   + size(sim.mutations)
            + "  n_subs: "  + size(sim.substitutions)
            + "  (" + format("%.0f", elapsed) + "s)\n");
    }

    if (community.tick % CKPT_EVERY == 0 & community.tick < END_TICK) {
        sim.treeSeqOutput(outfile + ".tick" + community.tick + ".trees");
        catn("Checkpoint at tick " + community.tick);
    }
}

END_TICK late() {
    sim.treeSeqOutput(outfile + ".trees");

    // [E] one-line summary per run, for the sweep table.
    // V_P = V_G because there is no environmental variance in the simulation.
    inds = sim.subpopulations.individuals;
    z  = inds.sumOfMutationsOfType(m2) + FIXED_OFFSET;
    vg = var(z);
    hdr = paste(c("outfile","neutral","V_S","mean_effect","sd_effect",
                  "sigma2_m","U_trait","V_M","N_final","V_G","V_M_over_V_P",
                  "V_S_over_V_P","lambda_pred","n_seg","n_subs"), sep="\t");
    row = paste(c(outfile, NEUTRAL, V_S, MEAN_EFFECT, SD_EFFECT,
                  SIGMA2_M, U_TRAIT, V_M, size(inds), vg, V_M / vg,
                  NEUTRAL ? 0.0 else V_S / vg, LAMBDA_PRED,
                  size(sim.mutations), size(sim.substitutions)), sep="\t");
    writeFile(outfile + ".summary.tsv", c(hdr, row));
    catn("Wrote " + outfile + ".summary.tsv");

    sim.simulationFinished();
}
