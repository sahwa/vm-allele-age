// updated from version 1.0:
// [1]: increase N to 100 000 individuals so they are less related and we have a larger
//	sample size for GREML construction - also more mutations to use
// [2]: reduce the burn-in to 10 000 - since we can rely on recapitation - but make sure 
// 	to check we have actually reached mutation-drift equilibrium 

initialize() {
    defineConstant("N", 100000);
    defineConstant("L", 1e8);
    initializeTreeSeq();
    initializeMutationRate(0);
    initializeRecombinationRate(1e-8);
    initializeMutationType("m2", 0.5, "f", 0.0);
    initializeGenomicElementType("g2", m2, 1);
    initializeGenomicElement(g2, 0, L-1);
}

1 early() { sim.addSubpop("p1", N); }

initialize() {
    defineConstant("start_time", clock());
}

1: late() {
    if (community.tick % 1000 == 0) {
        elapsed = clock() - start_time;
        gen_per_sec = community.tick / elapsed;
        remaining_gens = 10000 - community.tick;
        remaining_secs = remaining_gens / gen_per_sec;
        cat("Generation " + community.tick + " / 100000  "
            + "(" + format("%.1f", elapsed) + "s elapsed, "
            + format("%.0f", remaining_secs) + "s remaining)\n");
    }
}

10000 late() {
    sim.treeSeqOutput("1.1_neutral_out.trees");
    sim.simulationFinished();
}


